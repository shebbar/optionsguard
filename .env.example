# Postgres connection string. v1 expects a database named "optionguard" on
# whatever Postgres server/container you already run locally -- create it
# once with `createdb optionguard` (or `CREATE DATABASE optionguard;`).
# Used when running `uv run optionguard serve` directly on the host.
DATABASE_URL=postgresql+psycopg://youruser:yourpassword@127.0.0.1:5432/optionguard

# Same database, but reached by your Postgres container's name on the Docker
# network instead of 127.0.0.1 -- only needed for `docker compose up`. If
# your Postgres container is also on the `pwm-net` network as "pgdb" (see
# docker-compose.yml), this is usually DATABASE_URL with "127.0.0.1" swapped
# for "pgdb".
DATABASE_URL_DOCKER=postgresql+psycopg://youruser:yourpassword@pgdb:5432/optionguard

# Kite Connect -- leave blank until you have real API credentials. With these
# unset, the "kite" market data source is unavailable and /checks falls back
# to "mock" (a fake provider returning kiteconnect-shaped responses) or
# "manual". See config.toml [market_data].
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8787/kite/callback

# Random string used to sign the web UI's CSRF token. `openssl rand -hex 32`
OPTIONGUARD_SECRET_KEY=
